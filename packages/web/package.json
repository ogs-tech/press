{
  "name": "@ogs-tech/press-web",
  "version": "0.3.1",
  "description": "press engine — front-end renderer + CMS→TS type-sync",
  "license": "MIT",
  "author": "Odenir Gomes",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogs-tech/press.git",
    "directory": "packages/web"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./types": { "types": "./src/types/base.ts", "default": "./src/types/base.ts" }
  },
  "bin": {
    "press": "./bin/press.ts",
    "press-sync-types": "./bin/sync-types.ts"
  },
  "scripts": {
    "build": "echo '@ogs-tech/press-web ships TS source; nothing to build'",
    "sync-types": "tsx bin/sync-types.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "next": ">=15"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@ogs-tech/press-shared": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^18",
    "react": "^18.3.1",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
