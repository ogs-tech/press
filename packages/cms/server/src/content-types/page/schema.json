{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Base page provided by the press engine"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title" },
    "body": {
      "type": "customField",
      "customField": "plugin::press-cms.builder"
    },
    "seo": { "type": "component", "repeatable": false, "component": "preset-config.seo-page" }
  }
}
