{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    // This is a pnpm monorepo where Strapi (apps/cms) uses React 18 and this app
    // uses React 19. `next` is hoisted to the repo-root node_modules next to
    // @types/react@18, so Next's own .d.ts files resolve React 18 while this app's
    // files (and the symlinked @press/web source) resolve React 19 — two React type
    // identities collide ("Component … is not a valid JSX element type"). `typeRoots`
    // keeps the ambient @types to this package's v19; `paths` forces every `react`/
    // `react-dom` import in the program (including hoisted Next types) onto v19.
    "typeRoots": [
      "./node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
