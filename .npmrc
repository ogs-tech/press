# Strapi expects a flat, npm-like node_modules. node-linker=hoisted gives that
# under pnpm and is the most reliable layout for Strapi 5 (spec §4 stack pin).
node-linker=hoisted
# Strapi peer-dep graph is wide; let pnpm satisfy peers automatically.
auto-install-peers=true
strict-peer-dependencies=false
# Spike contract integrity (spec §7): the host must consume @press/cms from the
# registry tarball, NOT the local workspace source — otherwise the update proof
# would test a symlink instead of real semver. Disable workspace auto-linking so
# a non-`workspace:` range always resolves from Verdaccio, even across reinstalls.
link-workspace-packages=false
# Spike: route @press scope to local Verdaccio registry (localhost-only token — harmless for spike)
@press:registry=http://localhost:4873
//localhost:4873/:_authToken=ZDMyN2Y1NzBhNGU2ZDgwOTQ2YzU2ZmE1MGU3MDhlNzM6YmQyNWNkMjc2NmI1YTg1ODdjMzE4Ng==
