# Strapi expects a flat, npm-like node_modules. node-linker=hoisted gives that
# under pnpm and is the most reliable layout for Strapi 5 (spec §4 stack pin).
node-linker=hoisted
# Strapi peer-dep graph is wide; let pnpm satisfy peers automatically.
auto-install-peers=true
strict-peer-dependencies=false
# Non-`workspace:` @press ranges resolve from Verdaccio (the cli-e2e flow
# publishes real tarballs and installs them in a scratch project). The in-repo
# playground consumes @press/* via an explicit `workspace:*`, which always links
# the local source regardless of this flag.
link-workspace-packages=false
# Route @press scope to local Verdaccio registry (localhost-only token — harmless)
@press:registry=http://localhost:4873
//localhost:4873/:_authToken=ZDMyN2Y1NzBhNGU2ZDgwOTQ2YzU2ZmE1MGU3MDhlNzM6YmQyNWNkMjc2NmI1YTg1ODdjMzE4Ng==
