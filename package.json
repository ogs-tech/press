{
  "name": "press-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "cms:dev": "pnpm --filter cms develop",
    "cms:build": "pnpm --filter cms build",
    "cms:start": "pnpm --filter cms start",
    "guard": "node scripts/contract-guard.mjs"
  },
  "devDependencies": {
    "@press/web": "workspace:*",
    "turbo": "2.9.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "core-js-pure",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "esbuild": "0.28.0"
    }
  }
}
