{
  "name": "press",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "play": "pnpm --filter playground dev",
    "pack:check": "pnpm build && pnpm -r --filter \"./packages/*\" publish --dry-run --no-git-checks"
  },
  "devDependencies": {
    "@press/cms": "workspace:*",
    "@press/web": "workspace:*",
    "turbo": "2.9.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "core-js-pure",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@strapi/sdk-plugin>esbuild": "0.28.0",
      "esbuild-loader>esbuild": "0.28.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@types/react": "^18.3.31",
      "@types/react-dom": "^18.3.7"
    }
  }
}
